// Test configuration for the memory region determinism regression test.
//
// Same setup as `test_config_memory_region.json5`, but the region is initialized
// with a known value so repeated campaigns must produce identical results.
{
    elf: "tests/bin/test.elf",
    class: [
        "single",
        "glitch",
    ],
    memory_regions: [
        // Unmapped memory region for test
        {
            address: "0x30000000",
            size: "0x1000",         // 4 KB
            data_u32: "0xA5A5A5A5",
        },
    ],
}
