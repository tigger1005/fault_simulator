// Counterpart to test_config_result_checks.json5 that exercises the *failure*
// checkpoint: the region holds a value check_secret() rejects, so the baseline
// takes the negative path and every run must end on the failure check.
{
    elf: "tests/bin/test.elf",
    class: [
        "single",
        "glitch",
    ],
    max_instructions: 200,
    log_level: "debug",

    memory_regions: [
        {
            address: "0x30000000",
            size: "0x1000",
            data_u32: "0xDEADBEEF",
        },
    ],

    result_checks: {
        success_checks: [
            {
                address: "0x08000656",
                expected_registers: {
                    R0: "0x00000001",
                }
            }
        ],
        failure_checks: [
            {
                address: "0x08000656",
                expected_registers: {
                    R0: "0x00000000",
                }
            }
        ]
    }
}
